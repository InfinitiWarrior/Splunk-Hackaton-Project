# TriagaSOAR — copy this file to .env and fill in your values
# See README.md for setup instructions


# ── Splunk container (optional, for self-contained demo) ──────────────────
SPLUNK_PASSWORD=changeme123! # Change this
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_TOKEN=
SPLUNK_WRITE_TOKEN=
SPLUNK_VERIFY_SSL=false
SPLUNK_TOKEN_FILE=/splunk-shared/splunk_token

# ── LLM mode: "local" (Ollama) or "cloud" (API) ──────────────────────────
LLM_MODE=local

# ── Local mode — Ollama ───────────────────────────────────────────────────
# Only used when LLM_MODE=local
OLLAMA_HOST=http://localhost:11434
REASONER_MODEL=qwen3:14b
ROUTER_MODEL=qwen3:1.7b

# ── Cloud mode ────────────────────────────────────────────────────────────
# Only used when LLM_MODE=cloud
# Provider: "openai" or "anthropic"
CLOUD_PROVIDER=anthropic
# OpenAI model examples: gpt-4o, gpt-4o-mini, o1
# Anthropic model examples: claude-sonnet-4-6, claude-haiku-4-5-20251001
CLOUD_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Teams webhook (optional, for playbook notifications) ──────────────────
TEAMS_WEBHOOK_URL=


# ── Database ──────────────────────────────────────────────────────────────
DB_PATH=/app/data/cases.db
PUBLIC_API_URL=http://localhost:3000

# -- Postgres local auth
POSTGRES_DB=soc_triage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
AUTH_APP_PASSWORD=
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── Saved search monitor ──────────────────────────────────────────────────
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
MONITOR_COOLDOWN_MINUTES=5

# ── Threat intelligence (optional) ───────────────────────────────────────
# Get a free API key at https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=


# EntraID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Maester (optional, for enrichment)
MAESTER_TENANT_ID=
MAESTER_CLIENT_ID=
MAESTER_CLIENT_SECRET=
MAESTER_INTERVAL_MINUTES=60

#Scubagear (optional, for vulnerability scanning)
SCUBAGEAR_TENANT_ID=
SCUBAGEAR_CLIENT_ID=
SCUBAGEAR_CERT_THUMBPRINT=
SCUBAGEAR_INTERVAL_MINUTES=60
SCUBAGEAR_ORGANIZATION=

# Okta (optional, for enrichment)
OKTA_DOMAIN=
OKTA_API_TOKEN=

# Auth0 (optional, for enrichment)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── Velociraptor (optional, for endpoint hunting) ─────────────────────────
VELOCIRAPTOR_ENABLED=true
VELOX_USER=admin
VELOX_PASSWORD=changeme123! # Change this
VELOX_FRONTEND_HOSTNAME=localhost
